{
  // The root tsconfig excludes e2e/ on purpose: Next dev's file watcher follows
  // the root include set, and every spec write would otherwise Fast-Refresh
  // reload the pages tests are driving. Type-check the suite with
  // `pnpm typecheck:e2e` instead.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "plugins": []
  },
  "include": ["./**/*.ts", "../playwright.config.ts"],
  "exclude": []
}
