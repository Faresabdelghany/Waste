{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    ".nvmrc"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@waste/api#dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "HOST",
        "PORT",
        "DATABASE_URL",
        "SUPABASE_URL"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "@waste/api#test": {
      "dependsOn": [
        "^test"
      ],
      "cache": false,
      "env": [
        "DATABASE_ADMIN_URL",
        "DATABASE_URL",
        "SUPABASE_URL",
        "REQUIRE_DATABASE"
      ]
    },
    "test:e2e": {
      "cache": false
    },
    "@waste/db#test": {
      "dependsOn": [
        "^test"
      ],
      "cache": false,
      "env": [
        "DATABASE_ADMIN_URL",
        "DATABASE_URL",
        "REQUIRE_DATABASE"
      ]
    }
  }
}
