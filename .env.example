# Copy to .env at the repository root. Node reads it (--env-file-if-exists) for
# the API's dev, start and test scripts and for the database package's test,
# migrate and bootstrap scripts; drizzle.config.ts reads it too. Never commit .env.

# The local Supabase stack (`pnpm db:start`): the owner role, for migrations,
# bootstrap and tests. Never given to the API process.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# The API's role: owns nothing, bypasses nothing. `pnpm db:bootstrap` gives it
# LOGIN with this password on the local stack. Required by the API: without it
# the process refuses to start, and GET /readyz is 503 until it answers.
DATABASE_URL=postgresql://wms_api:wms_api@127.0.0.1:54322/postgres

# CI sets REQUIRE_DATABASE=1 so a database test may not skip.
# REQUIRE_DATABASE=1
