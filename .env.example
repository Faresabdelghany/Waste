# Copy to .env at the repository root. Node reads it (--env-file-if-exists) for
# the API's and the worker's dev, start and test scripts and for the database
# package's test, migrate, bootstrap and seed scripts. Never commit .env.

# The local Supabase stack (`pnpm db:start`): the owner role, for migrations,
# bootstrap, the demo seed and tests. Never given to the API process.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# The API's role: owns nothing, bypasses nothing. `pnpm db:bootstrap` gives it
# LOGIN with this password on the local stack. Required by the API: without it
# the process refuses to start, and GET /readyz is 503 until it answers.
DATABASE_URL=postgresql://wms_api:wms_api@127.0.0.1:54322/postgres

# The sync role (Issue #104, ADR-0004): `wms_sync`, which the PowerSync service
# connects as — REPLICATION and BYPASSRLS, SELECT on the synced tables and
# nothing else, created NOLOGIN by migration 0008. `pnpm db:bootstrap` gives it
# LOGIN with this password on the local stack when the variable is set; an
# environment without a PowerSync instance leaves it unset and the role keeps
# no login. Nothing in part A reads it; part B's sync-rules tests will.
# SYNC_DATABASE_URL=postgresql://wms_sync:wms_sync@127.0.0.1:54322/postgres

# The worker role (Issue #97 part B, ADR-0007): `wms_worker`, which the
# worker's pg-boss connects as — BYPASSRLS for the one kind of statement that
# reads across tenants, SELECT on every wms table and no write right on any,
# created NOLOGIN by migration 0011, which also installs pg-boss's schema.
# `pnpm db:bootstrap` gives it LOGIN with this password on the local stack when
# the variable is set. Required by the worker (`apps/worker`), together with
# DATABASE_URL above, on which its jobs write as wms_api under withCompany;
# both must be a session connection, never the transaction pooler on 6543.
WORKER_DATABASE_URL=postgresql://wms_worker:wms_worker@127.0.0.1:54322/postgres

# The routing provider the API and the worker route through (#39): unset or
# "fake" is the deterministic fake, which CI and the e2e lane always use
# (#131); "openrouteservice" (#171) is the Pilot's. Both call it — the
# worker's jobs, and the API for the guided setup's preview (#173) — so both
# need OPENROUTESERVICE_API_KEY, one person's key from a free Standard
# account (account.heigit.org, no card), server-side only and never
# committed, and each refuses to start without it.
# ROUTING_PROVIDER=fake
# OPENROUTESERVICE_API_KEY=

# The routing quota knobs (#132 §1, #171), the Standard plan's figures when
# unset: where the worker's batch work stops per family (the remaining it
# leaves for the office's own calls), and how many calls a minute each
# family makes — the worker's 30 and the API's preview 10 (#173), which
# together are the plan's 40 on the one key, so raising one means lowering
# the other.
# ROUTING_DIRECTIONS_RESERVE=500
# ROUTING_OPTIMISATION_RESERVE=100
# ROUTING_CALLS_PER_MINUTE=30
# ROUTING_PREVIEW_CALLS_PER_MINUTE=10

# The Pilot's knobs (#149, ADR-0008), each the code's default when unset:
# the API's request pool, the worker's two pools, and the worker's polling,
# pg-boss supervise and queue-cache intervals and pg-boss pool idle timeout.
# A workstation leaves them unset; the Pilot's values are Suga's environment,
# listed in apps/pilot/README.md.
# DATABASE_POOL_MAX=5
# WORKER_API_POOL_MAX=3
# WORKER_POOL_MAX=2
# WORKER_POLLING_INTERVAL_SECONDS=30
# WORKER_SUPERVISE_INTERVAL_SECONDS=300
# WORKER_QUEUE_CACHE_INTERVAL_SECONDS=300
# WORKER_BOSS_IDLE_TIMEOUT_SECONDS=600

# CI sets REQUIRE_DATABASE=1 so a database test may not skip.
# REQUIRE_DATABASE=1

# The Supabase project whose Auth signs the tokens the API accepts (waste-pilot):
# the token issuer is ${SUPABASE_URL}/auth/v1 and the signing keys are fetched
# from ${SUPABASE_URL}/auth/v1/.well-known/jwks.json. The origin only, without
# a trailing slash. Required by the API; its tests verify against a key set
# they generate and never fetch it, so CI sets a placeholder. Against the
# trimmed local stack (`pnpm stack:start`, Issue #151) it is the stack's own
# Auth behind Kong: http://127.0.0.1:54321.
SUPABASE_URL=https://ztmisreemxepvjxelbql.supabase.co

# The local stack's Logins (`pnpm db:logins`, run by `pnpm stack:start`): one
# confirmed Login per seeded account, for the API e2e suite's tester, and per
# address listed here; a new Login takes LOCAL_LOGIN_PASSWORD or the public
# local default (at least the eight characters Auth asks for), and an existing
# one keeps its own.
# Loopback only; the Pilot's Logins are the owner's.
# LOCAL_EXTRA_LOGINS=somebody@waste-e2e.example
# LOCAL_LOGIN_PASSWORD=local-waste-password
