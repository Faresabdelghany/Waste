{
  "name": "waste",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:api": "turbo run test:e2e:api",
    "typecheck:e2e": "pnpm --filter @waste/web typecheck:e2e",
    "db:signing-key": "pnpm --filter @waste/db signing-key",
    "db:start": "pnpm db:signing-key && supabase db start",
    "db:stop": "pnpm db:signing-key && supabase stop",
    "stack:start": "pnpm db:signing-key && supabase start -x realtime,storage-api,imgproxy,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor && pnpm db:migrate && pnpm db:bootstrap && pnpm db:seed && pnpm db:logins",
    "db:logins": "pnpm --filter @waste/db logins",
    "db:generate": "pnpm --filter @waste/db generate",
    "db:migrate": "pnpm --filter @waste/db migrate",
    "db:check": "pnpm --filter @waste/db check",
    "db:fingerprint": "pnpm --filter @waste/db fingerprint",
    "db:bootstrap": "pnpm --filter @waste/db bootstrap",
    "db:seed": "pnpm --filter @waste/db seed"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "supabase": "2.117.0",
    "turbo": "^2.10.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
