{
  // Server-only code (Node through tsx), like packages/documents: Node's types
  // from the base config, ECMAScript only, no DOM. The structural conventions
  // of the gated packages still hold (source by subpath, tests hidden, tests
  // in their own program).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext"],
    "target": "es2022",
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"]
}
