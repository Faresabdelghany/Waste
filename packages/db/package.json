{
  "name": "@waste/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The database foundation (Issue #64): the Drizzle schema of the `wms` Postgres schema, its SQL migrations, and the pieces every domain table is built from. Server-only: consumed by apps/api and the worker, never by apps/web (ADR-0001; the root ESLint config refuses the import there). Ships TypeScript source like every workspace package.",
  "exports": {
    "./package.json": "./package.json",
    "./__tests__/*": null,
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --env-file-if-exists=../../.env --import tsx --test --test-timeout=120000 \"src/**/*.test.ts\"",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env --import tsx scripts/migrate.ts",
    "bootstrap": "node --env-file-if-exists=../../.env --import tsx scripts/bootstrap-local.ts"
  },
  "dependencies": {
    "@waste/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
