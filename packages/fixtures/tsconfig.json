{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Shipping code sees ECMAScript only, exactly as packages/domain does:
    // the demo tenant runs in the browser bundle and in the seed alike.
    "lib": ["esnext"],
    "types": [],
    "target": "es2022",
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"]
}
