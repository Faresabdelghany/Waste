# Copy to apps/web/.env.local (gitignored). Next reads this directory's env
# files itself, so the root .env, which Node reads for the API and the
# database package, does not reach the web app. Every variable here is
# optional: with none of them set the app runs on fixture data exactly as the
# prototype always has (Issue #81).

# Where the browser calls the API. `/waste-api` is the path next.config.mjs
# proxies to WASTE_API_ORIGIN, so the call stays on the web's own origin and
# needs no CORS; once the API's CORS admits the web, this becomes the API's
# origin and WASTE_API_ORIGIN goes. Unset, the adapter is off. Set, the web
# runs as the Pilot does (Issue #150): every page but /login needs a session,
# /login offers the password form alone and no demo account, and a person
# lands where GET /me says. All four variables here are declared on
# `@waste/web#dev` and `#build` in turbo.json, since turbo runs in strict env
# mode and a build must know its inputs.
NEXT_PUBLIC_WASTE_API_URL=/waste-api
WASTE_API_ORIGIN=http://127.0.0.1:3001

# The Supabase project whose Auth signs the tokens the API verifies — the same
# project the API's SUPABASE_URL names — and its publishable (anon) key, which
# Auth asks for on every request. Both are safe in a browser: the key opens
# nothing by itself and the domain schema is not exposed to it (ADR-0001).
# Unset, /login offers the fixture account picker alone — or, with the API
# set, says that password sign-in is not configured.
NEXT_PUBLIC_SUPABASE_URL=https://ztmisreemxepvjxelbql.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
